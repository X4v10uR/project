{
  "name": "subly-theme",
  "version": "1.0.0",
  "description": "Tailwind build for Subly",
  "scripts": {
    "dev": "tailwindcss -i ./src/input.css -o ../static/css/dist/styles.css --watch",
    "build": "tailwindcss -i ./src/input.css -o ../static/css/dist/styles.css --minify"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "postcss-import": "^16.1.1",
    "tailwindcss": "^3.4.17"
  }
}
